# Required for accurate presence across production server instances.
# Create a free Redis database in Upstash or through the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-your-rest-token

# PostHog browser analytics. Leave the project token empty to disable capture.
# Copy to apps/web/.env.local for local use, or set these in your hosting provider.
# Use the public project token from PostHog project settings, not a personal API key.
# For an EU project, use https://eu.i.posthog.com instead.
# Restart the dev server or rebuild the deployment after changing these values.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
