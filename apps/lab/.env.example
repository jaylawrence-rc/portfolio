# Kit's public JavaScript embed for the dedicated first Agent Skill early-access form.
# In Kit, open that form's Embed > JavaScript panel and copy the data-uid and src
# values from its generated script. Both values are required to display the form.
# Leave them blank to show the Lab's honest pending state until the form is ready.
# These are public embed identifiers, not a Kit API key or subscriber credentials.
NEXT_PUBLIC_KIT_EMBED_UID=
NEXT_PUBLIC_KIT_EMBED_SRC=
