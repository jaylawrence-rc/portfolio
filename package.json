{
  "name": "jay-lawrence-portfolio",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "dev:lab": "pnpm --filter lab dev",
    "build:lab": "pnpm --filter lab build",
    "lint:lab": "pnpm --filter lab lint",
    "build:all": "pnpm -r --filter './apps/*' build",
    "lint:all": "pnpm -r --filter './apps/*' lint"
  }
}
